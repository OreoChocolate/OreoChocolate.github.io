<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    {% assign cv_url = page.nav_link | relative_url %}
    <title>{{ page.title }} | {{ site.first_name }} {{ site.last_name }}</title>
    <meta name="robots" content="noindex, follow">
    <link rel="canonical" href="{{ cv_url | absolute_url }}">
    <meta http-equiv="refresh" content="0; url={{ cv_url }}">
  </head>
  <body>
    <p>Redirecting to the <a href="{{ cv_url }}">CV (PDF)</a>...</p>
  </body>
</html>
